{
  "name": "earshot",
  "version": "0.0.34",
  "description": "A voice-first app framework for Even Realities G2 glasses: declare what your app can do, then hold and say it.",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "./dist/check/cli.js",
    "./dist/relay/cli.js"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jarekbird/earshot.git"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./check": {
      "types": "./dist/check/index.d.ts",
      "default": "./dist/check/index.js"
    },
    "./testing": {
      "types": "./dist/glasses/fake.d.ts",
      "default": "./dist/glasses/fake.js"
    },
    "./sim": {
      "types": "./dist/sim/index.d.ts",
      "default": "./dist/sim/index.js"
    },
    "./relay": {
      "types": "./dist/relay/relay.d.ts",
      "default": "./dist/relay/relay.js"
    },
    "./relay/node": {
      "types": "./dist/relay/node.d.ts",
      "default": "./dist/relay/node.js"
    }
  },
  "types": "./dist/index.d.ts",
  "bin": {
    "earshot-check": "./dist/check/cli.js",
    "earshot-relay": "./dist/relay/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && tsc -p tsconfig.check.json && tsc -p tsconfig.sim.json && tsc -p tsconfig.relay.json",
    "prepare": "npm run build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "check:sim": "vitest run --config vitest.sim.config.ts",
    "example:pack": "npm run build && node example/build.mjs && node dist/check/cli.js example/build/app.json example/dist && evenhub pack example/build/app.json example/dist -o example/build/earshot-example.ehpk",
    "format": "prettier --write .",
    "check": "prettier --check . && tsc --noEmit && vitest run && npm run build"
  },
  "dependencies": {
    "@evenrealities/pretext": "0.1.4",
    "acorn": "8.19.0"
  },
  "peerDependencies": {
    "@evenrealities/even_hub_sdk": ">=0.0.16"
  },
  "devDependencies": {
    "@evenrealities/even_hub_sdk": "0.0.16",
    "@evenrealities/evenhub-cli": "0.2.0",
    "@evenrealities/evenhub-simulator": "0.9.5",
    "@types/node": "^24.19.2",
    "esbuild": "0.28.2",
    "prettier": "^3.10.1",
    "typescript": "^5.7.0",
    "vitest": "^3.2.7"
  }
}
